<Window x:Class="CoolerScreenControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cooler Screen Control" Height="680" Width="660"
        MinHeight="640" MinWidth="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing">
    <Grid Margin="20" TextElement.Foreground="{DynamicResource TextBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Screen rotation" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <TextBlock Grid.Row="1" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,14" LineHeight="21">
            <Run Text="Choose what the cooler's screen shows."/><LineBreak/>
            <Run Text="•  Tick the items you want, and reorder them with the arrows."/><LineBreak/>
            <Run Text="•  Shown for: how long each item stays on screen."/><LineBreak/>
            <Run Text="•  Refresh: how often its number may change."/><LineBreak/>
            <Run Text="•  The number never goes dark. Labels (CPU, RAM, %, °C) are optional, because the cooler makes them blink."/>
        </TextBlock>

        <ListView Grid.Row="2" x:Name="ItemsList" Margin="0,0,0,14">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="On" Width="40">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" Checked="AnySetting_Changed" Unchecked="AnySetting_Changed"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Item" Width="170" DisplayMemberBinding="{Binding DisplayName}"/>
                    <GridViewColumn Header="Shown for" Width="130">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Text="{Binding DurationValue, Mode=TwoWay, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"
                                             Width="40" LostFocus="AnySetting_Changed"
                                             ToolTip="How long this item stays on screen before moving to the next one."/>
                                    <ComboBox x:Name="DurationUnitCombo" Width="70" Margin="4,0,0,0"
                                              SelectedValuePath="Tag"
                                              SelectedValue="{Binding DurationUnit, Mode=TwoWay}"
                                              SelectionChanged="AnySetting_Changed">
                                        <ComboBoxItem Content="sec" Tag="Seconds"/>
                                        <ComboBoxItem Content="min" Tag="Minutes"/>
                                        <ComboBoxItem Content="hr" Tag="Hours"/>
                                    </ComboBox>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Refresh (sec)" Width="105">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding RefreshSeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"
                                         Width="50" LostFocus="AnySetting_Changed"
                                         ToolTip="How often (seconds) the displayed number is allowed to change while this item is showing. The app writes to the screen every second regardless, to keep it lit - this only controls how often that written value updates, so a jittery metric like CPU Usage % can hold visually still."/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Order" Width="90">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="▲" Width="28" Padding="0,3" Click="MoveUp_Click" Tag="{Binding}"/>
                                    <Button Content="▼" Width="28" Padding="0,3" Click="MoveDown_Click" Tag="{Binding}" Margin="4,0,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,14">
            <TextBlock Text="Add custom number:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="CustomValueBox" Width="50" Text="0"/>
            <Button Content="Add" Click="AddCustom_Click" Margin="8,0,0,0" Padding="12,4"/>
            <Button Content="Remove selected" Click="RemoveSelected_Click" Margin="8,0,0,0" Padding="12,4"/>
        </StackPanel>

        <Border Grid.Row="4" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrushDark}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,14">
            <StackPanel>
                <WrapPanel>
                    <TextBlock Text="Pomodoro" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,4"/>
                    <TextBlock Text="Work" VerticalAlignment="Center" Margin="0,0,4,4"/>
                    <TextBox x:Name="WorkMinutesBox" Width="36" Text="25" LostFocus="PomodoroSettings_Changed" Margin="0,0,4,4"/>
                    <TextBlock Text="min" VerticalAlignment="Center" Margin="0,0,12,4"/>
                    <TextBlock Text="Break" VerticalAlignment="Center" Margin="0,0,4,4"/>
                    <TextBox x:Name="BreakMinutesBox" Width="36" Text="5" LostFocus="PomodoroSettings_Changed" Margin="0,0,4,4"/>
                    <TextBlock Text="min" VerticalAlignment="Center" Margin="0,0,20,6"/>
                    <Button x:Name="PomodoroStartButton" Content="Start" Click="PomodoroStart_Click" Padding="14,4" Margin="0,0,6,4" Style="{DynamicResource AccentButton}"/>
                    <Button Content="Reset" Click="PomodoroReset_Click" Padding="14,4" Margin="0,0,0,4"/>
                </WrapPanel>
                <TextBlock x:Name="PomodoroStatusText" Text="Not running. The cooler shows minutes left, then seconds in the last minute." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,8"/>
                <CheckBox x:Name="PomodoroFocusCheck" Content="While it runs, show only the timer on the cooler" IsChecked="True" Checked="AnySetting_Changed" Unchecked="AnySetting_Changed"/>
            </StackPanel>
        </Border>

        <WrapPanel Grid.Row="5" Margin="0,0,0,14">
            <CheckBox x:Name="CelsiusCheck" Content="Celsius (uncheck for Fahrenheit)" IsChecked="True" Checked="AnySetting_Changed" Unchecked="AnySetting_Changed" Margin="0,0,20,6"/>
            <CheckBox x:Name="StartWithWindowsCheck" Content="Start with Windows" Checked="StartWithWindowsCheck_Changed" Unchecked="StartWithWindowsCheck_Changed" Margin="0,0,20,6"/>
            <CheckBox x:Name="MinimizeToTrayCheck" Content="Minimize to tray" Margin="0,0,20,6"/>
            <CheckBox x:Name="DarkModeCheck" Content="Dark mode" Checked="DarkMode_Changed" Unchecked="DarkMode_Changed" Margin="0,0,20,6"/>
            <CheckBox x:Name="ShowLabelsCheck" Content="Show labels (CPU / RAM / % / °C)" Checked="AnySetting_Changed" Unchecked="AnySetting_Changed"
                      ToolTip="Shows RAM / CPU / % / °C next to the number. The cooler rotates its labels by itself, so they blink (a hardware limit). Off = steady number only, no labels."/>
        </WrapPanel>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock x:Name="TemperatureNote" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,0,12,4" Foreground="#E0A94E"
                           Text="CPU temperature needs administrator rights, so it is skipped in this mode."/>
                <TextBlock x:Name="StatusText" Text="Stopped." Foreground="{DynamicResource MutedBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Show log file" Click="OpenLog_Click" Padding="14,7" Margin="0,0,8,0"/>
                <Button x:Name="StartStopButton" Content="Start" Click="StartStopButton_Click" Padding="24,7" Style="{DynamicResource AccentButton}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
