<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CoolerScreenControl</AssemblyName>
    <RootNamespace>CoolerScreenControl</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Configurations>Debug;Release;Store</Configurations>
  </PropertyGroup>

  <!-- Microsoft Store build: no administrator rights (CPU temperature is skipped) -->
  <PropertyGroup Condition="'$(Configuration)' == 'Store'">
    <ApplicationManifest>app.store.manifest</ApplicationManifest>
    <Optimize>true</Optimize>
    <DefineConstants>$(DefineConstants);STORE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HidSharp" Version="2.1.0" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.4" />
  </ItemGroup>

</Project>
